# ==============================================================
# Profit-Loss ERP Backend Environment Configuration
# ==============================================================

# Port to run the server on (Render automatically provides PORT in production)
PORT=5050

# Mode ('development' or 'production')
NODE_ENV=development

# --------------------------------------------------------------
# OPTION A: Cloud PostgreSQL (Render / Neon / Supabase)
# If DATABASE_URL is set, it will be prioritized over individual DB_* fields
# --------------------------------------------------------------
DATABASE_URL=postgres://user:password@hostname:5432/profit_loss

# --------------------------------------------------------------
# OPTION B: Local PostgreSQL (when running locally)
# --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_NAME=profit_loss

# --------------------------------------------------------------
# Security Secrets & Auth
# --------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_key_for_production

# --------------------------------------------------------------
# Allowed Frontend Origins (CORS)
# Set to your Vercel URL in production (e.g. https://your-app.vercel.app)
# Or leave as * for open access across origins
# --------------------------------------------------------------
CORS_ORIGIN=*
